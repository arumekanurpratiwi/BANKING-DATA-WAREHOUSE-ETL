  <step>
    <name>Table input DimCustomer</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>SQLServer_SAMPLE</connection>
    <sql>SELECT
    c.customer_id AS CustomerID,
    c.customer_name AS CustomerName,
    c.address AS Address,
    ci.city_name AS CityName,
    s.state_name AS StateName,
    c.age AS Age,
    c.gender AS Gender,
    c.email AS Email
FROM customer c
INNER JOIN city ci
    ON c.city_id = ci.city_id
INNER JOIN state s
    ON ci.state_id = s.state_id;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
