    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var dateText = TransactionDate == null ? null : TransactionDate.toString();
var normalizedDate = null;

if (dateText != null &amp;&amp; dateText != "") {
    var p1 = dateText.match(/^(\d{4})\/(\d{2})\/(\d{2})\s+(\d{2}):(\d{2}):(\d{2})/);
    var p2 = dateText.match(/^(\d{2})-(\d{2})-(\d{4})\s+(\d{2}):(\d{2}):(\d{2})/);

    if (p1 != null) {
        normalizedDate = p1[1] + "-" + p1[2] + "-" + p1[3] + " " + p1[4] + ":" + p1[5] + ":" + p1[6];
    }
    else if (p2 != null) {
        normalizedDate = p2[3] + "-" + p2[2] + "-" + p2[1] + " " + p2[4] + ":" + p2[5] + ":" + p2[6];
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
